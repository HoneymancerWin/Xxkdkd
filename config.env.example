# Скопируй этот файл в config.env и заполни.
#   cp config.env.example config.env

# Кодовое имя твоего Pixel (таблица в docs/BUILD.md), например: husky = Pixel 8 Pro
DEVICE=

# Тег релиза GrapheneOS, на котором строим систему.
# Список тегов: https://grapheneos.org/releases (например 2025112000)
GOS_TAG=

# Где будут лежать исходники (~300-400 ГБ!)
SRC_DIR="$HOME/kimderheim-src"

# Где хранить ключи подписи (держи в безопасности и сделай резервную копию!)
KEYS_DIR="$HOME/kimderheim-keys"

# Число параллельных задач сборки (по умолчанию = числу ядер)
JOBS=$(nproc)
